<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
        <Setter Property="FontFamily" Value="Inter, sans-serif"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}"/>
    </Style>

    <Style Selector="TextBlock.section-label">
        <Setter Property="FontFamily" Value="Inter, sans-serif"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}"/>
    </Style>

    <Style Selector="TextBlock.headline-large">
        <Setter Property="FontFamily" Value="Inter, sans-serif"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="28"/>
    </Style>

    <Style Selector="TextBlock.body-large">
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="FontFamily" Value="Inter, sans-serif"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.nav">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}"/>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryContainerBrush}"/>
        <Setter Property="FontFamily" Value="Inter, sans-serif"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style Selector="TextBox.input">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
    </Style>

    <Style Selector="Slider">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Border.card-high">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Border.card-hero">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Border.card-error">
        <Setter Property="Background" Value="{DynamicResource ErrorContainerBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Border.input-field">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Border.chip-primary">
        <Setter Property="Background" Value="{DynamicResource PrimaryContainerBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Border.chip-secondary">
        <Setter Property="Background" Value="{DynamicResource SecondaryContainerBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Border.setting-card">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="20,16"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Border.lang-chip">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}"/>
    </Style>

    <Style Selector="Border.lang-chip-active">
        <Setter Property="Background" Value="{DynamicResource PrimaryContainerBrush}"/>
    </Style>

    <Style Selector="Border.lang-chip TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Border.divider">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource OutlineVariantBrush}"/>
    </Style>

</Styles>