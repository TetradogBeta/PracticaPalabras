<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="PrimaryColor">#6750A4</Color>
            <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
            <Color x:Key="PrimaryContainerColor">#EADDFF</Color>
            <Color x:Key="OnPrimaryContainerColor">#21005D</Color>

            <Color x:Key="SecondaryContainerColor">#E8DEF8</Color>
            <Color x:Key="OnSecondaryContainerColor">#1D192B</Color>

            <Color x:Key="TertiaryContainerColor">#FFD8E4</Color>
            <Color x:Key="OnTertiaryContainerColor">#31111D</Color>

            <Color x:Key="SurfaceColor">#FEF7FF</Color>
            <Color x:Key="SurfaceContainerLowColor">#F7F2FA</Color>
            <Color x:Key="SurfaceContainerColor">#F3EDF7</Color>
            <Color x:Key="SurfaceContainerHighColor">#ECE6F0</Color>
            <Color x:Key="OnSurfaceColor">#1D1B20</Color>
            <Color x:Key="OnSurfaceVariantColor">#49454F</Color>

            <Color x:Key="OutlineColor">#79747E</Color>
            <Color x:Key="OutlineVariantColor">#CAC4D0</Color>

            <Color x:Key="ErrorColor">#B3261E</Color>
            <Color x:Key="ErrorContainerColor">#F9DEDC</Color>
            <Color x:Key="OnErrorContainerColor">#410E0B</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="PrimaryColor">#D0BCFF</Color>
            <Color x:Key="OnPrimaryColor">#381E72</Color>
            <Color x:Key="PrimaryContainerColor">#4F378B</Color>
            <Color x:Key="OnPrimaryContainerColor">#EADDFF</Color>

            <Color x:Key="SecondaryContainerColor">#4A4458</Color>
            <Color x:Key="OnSecondaryContainerColor">#E8DEF8</Color>

            <Color x:Key="TertiaryContainerColor">#633B48</Color>
            <Color x:Key="OnTertiaryContainerColor">#FFD8E4</Color>

            <Color x:Key="SurfaceColor">#141218</Color>
            <Color x:Key="SurfaceContainerLowColor">#1D1B20</Color>
            <Color x:Key="SurfaceContainerColor">#211F26</Color>
            <Color x:Key="SurfaceContainerHighColor">#2B2930</Color>
            <Color x:Key="OnSurfaceColor">#E6E1E5</Color>
            <Color x:Key="OnSurfaceVariantColor">#CAC4D0</Color>

            <Color x:Key="OutlineColor">#938F99</Color>
            <Color x:Key="OutlineVariantColor">#49454F</Color>

            <Color x:Key="ErrorColor">#F2B8B5</Color>
            <Color x:Key="ErrorContainerColor">#8C1D18</Color>
            <Color x:Key="OnErrorContainerColor">#F9DEDC</Color>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="{DynamicResource PrimaryContainerColor}"/>
    <SolidColorBrush x:Key="SecondaryContainerBrush" Color="{DynamicResource SecondaryContainerColor}"/>
    <SolidColorBrush x:Key="OnSecondaryContainerBrush" Color="{DynamicResource OnSecondaryContainerColor}"/>
    <SolidColorBrush x:Key="TertiaryContainerBrush" Color="{DynamicResource TertiaryContainerColor}"/>
    <SolidColorBrush x:Key="OnTertiaryContainerBrush" Color="{DynamicResource OnTertiaryContainerColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="{DynamicResource SurfaceContainerColor}"/>
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="{DynamicResource SurfaceContainerHighColor}"/>
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{DynamicResource OnSurfaceColor}"/>
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="{DynamicResource OnSurfaceVariantColor}"/>
    <SolidColorBrush x:Key="OutlineVariantBrush" Color="{DynamicResource OutlineVariantColor}"/>
    <SolidColorBrush x:Key="ErrorContainerBrush" Color="{DynamicResource ErrorContainerColor}"/>
    <SolidColorBrush x:Key="OnErrorContainerBrush" Color="{DynamicResource OnErrorContainerColor}"/>

</ResourceDictionary>